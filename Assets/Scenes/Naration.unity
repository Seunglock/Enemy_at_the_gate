  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " \uD55C \uB54C \uB300\uB959\uC5D0\uC11C \uAC00\uC7A5 \uCC2C\uB780\uD55C
    \uAD6D\uAC00\uC600\uB358 \uC6B0\uB9AC \uC655\uAD6D\uC740 \uC9C0\uAE08 \uBAB0\uB77D\uC744
    \uBAA9\uC804\uC5D0 \uB450\uACE0 \uC788\uB2E4.\n\n \uBD81\uC11C\uCABD\uC5D0\uC11C
    \uC2DC\uC791\uB41C \uBAAC\uC2A4\uD130\uC758 \uCE68\uACF5\uC740 \uC18C\uADDC\uBAA8
    \uC18C\uC694\uC0AC\uD0DC\uAC00 \uC544\uB2CC \uC655\uAD6D \uBD81\uBD80\uB97C \uD729\uC4F0\uB294
    \uC7AC\uC559\uC774 \uB418\uC5C8\uACE0 \uC774\uB0B4, \uC601\uD1A0\uC758 \uB300\uBD80\uBD84\uC774
    \uD669\uD3D0\uD654\uB418\uC5C8\uB2E4.\n\n\uB05D\uB3C4 \uC5C6\uC774 \uBAB0\uB824\uB4DC\uB294
    \uB188\uB4E4\uC758 \uAD70\uC138\uC5D0, \uAD6D\uC655 \uD3D0\uD558\uAED8\uC11C\uB294
    \uC655\uAD6D\uC744 \uD3EC\uAE30\uD558\uB294 \uAC83\uC744 \uACB0\uC815\uD558\uC168\uB2E4.\n\n\uBC31\uC131\uB4E4\uC774
    \uD0C8\uCD9C\uD560 \uC2DC\uAC04\uC744 \uBC8C\uAE30 \uC704\uD574 \uD3D0\uD558\uAED8\uC11C\uB294
    \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uBCD1\uC0AC\uB4E4\uC744 \uB0B4\uAC8C \uB9E1\uAE30\uC2DC\uBA70
    \uC774 \uACF3, \uBCA0\uC2A4\uD2B8\uB78C \uACE0\uC6D0\uC744 \uC9C0\uD0A4\uB77C\uACE0
    \uBA85\uD558\uC168\uB2E4.\n\n\uB3CC\uC544\uC624\uC9C0 \uBABB\uD560 \uAC83\uC744
    \uC54C\uACE0 \uC788\uC9C0\uB9CC, \uB098\uC640 \uBCD1\uC0AC\uB4E4\uC740 \uBB3C\uB7EC\uB0A0
    \uC218 \uC5C6\uC5C8\uB2E4. \n\n \uC6B0\uB9AC\uC758 \uBC14\uB85C \uB4A4\uC5D0\uB294
    \uC218\uB3C4\uAC00 \uC788\uC73C\uB2C8."
